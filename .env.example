# ProMotion — contact form email delivery (server-only; never exposed to the client)
#
# Copy this file to `.env.local` and fill in real values to enable delivery.
# While ANY of these are missing, the /api/contact route returns a clear
# "not configured" response (HTTP 503) and the UI says so honestly.
#
# Default provider is Resend (https://resend.com) via a zero-dependency fetch
# call in app/api/contact/route.ts. See README.md for Formspree / SMTP options.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Where enquiries are delivered
CONTACT_TO_EMAIL=studio@example.com

# Verified sender on your Resend domain (e.g. "ProMotion <hello@yourdomain.com>")
CONTACT_FROM_EMAIL=ProMotion <hello@yourdomain.com>
